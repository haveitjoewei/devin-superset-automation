# Devin API Key
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=your-org-id

# GitHub Token
GITHUB_TOKEN=ghp-your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret
TARGET_REPO=haveitjoewei/superset
# Exact GitHub Actions check names, comma separated. Empty means keep waiting.
REQUIRED_CHECKS=
ALLOW_SIMULATED_EVENTS=false

# Slack (for observability reporting)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=Cyour-channel-id
ONCALL_SLACK_USER_ID=Uyour-oncall-user-id

# Database (job store + Superset data source)
DATABASE_URL=postgresql://devin:devin@localhost:5432/devin_jobs

# Worker Configuration
WORKER_POLL_INTERVAL=30
CONCURRENCY_CAP=2

# Admission guard across recorded live ACUs; 0 disables. Not a hard spend limit.
ACU_ADMISSION_CAP=100
